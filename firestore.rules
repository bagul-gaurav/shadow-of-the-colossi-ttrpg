rules_version = '2';
// Default rules (requireLogin = false in quartz/static/party/index.html):
// anyone can read notes and party objectives; only logged-in party members can write.
// Paste into Firebase console → Firestore → Rules. For login-only mode use firestore.login.rules instead.
// Party list lives in members/{username@party.local} = { name: "Kael", gm: false }. Add docs by hand in the console.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function memberPath() { return /databases/$(db)/documents/members/$(request.auth.token.email.lower()); }
    function member() { return signedIn() && exists(memberPath()); }
    function gm() { return member() && get(memberPath()).data.gm == true; }

    match /members/{email} {
      // Public: the login and player dropdowns list names before anyone logs in.
      allow read: if true;
      allow write: if gm();
    }

    // Public read; only the author or GM can edit or delete.
    match /notes/{id} {
      allow read: if true;
      allow create: if member() && request.resource.data.author == request.auth.uid;
      allow update: if member() && (resource.data.author == request.auth.uid || gm())
                    && request.resource.data.author == resource.data.author;
      allow delete: if member() && (resource.data.author == request.auth.uid || gm());
    }

    // Party objectives: public read, any member can tick. Private ones: owner and GM only.
    match /objectives/{id} {
      allow read: if resource.data.private == false || (member() && (resource.data.owner == request.auth.uid || gm()));
      allow create: if member() && request.resource.data.owner == request.auth.uid && request.resource.data.private is bool;
      allow update: if member() && request.resource.data.owner == resource.data.owner
                    && (resource.data.owner == request.auth.uid || gm()
                        || (resource.data.private == false && request.resource.data.private == false));
      allow delete: if member() && (resource.data.owner == request.auth.uid || gm());
    }

    // Character sheets: owner and GM only, in both modes.
    match /sheets/{id} {
      allow read: if member() && (resource.data.owner == request.auth.uid || gm());
      allow create: if member() && request.resource.data.owner == request.auth.uid;
      allow update: if member() && (resource.data.owner == request.auth.uid || gm())
                    && request.resource.data.owner == resource.data.owner;
      allow delete: if member() && (resource.data.owner == request.auth.uid || gm());
    }
  }
}
